# ==============================================================================
# ScholarX Backend Unified Environment Configuration
# Dual-Mode: Operates 100% locally when keys are empty, and auto-switches to
# live cloud providers as soon as credentials are provided.
# ==============================================================================

# Core Server Settings
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200
JWT_SECRET=scholarx_super_secret_jwt_key_2026
ADMIN_MASTER_ID=admin@scholarx.org
ADMIN_MASTER_PASS=AdminMaster#2026

# 1. DATABASE & AUTH: Supabase (PostgreSQL & Supabase Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. CLOUD OBJECT STORAGE: Cloudflare R2 (S3-Compatible, 0 Egress Fees)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=scholarx-papers
CLOUDFLARE_R2_PUBLIC_URL=

# 3. REAL-TIME VIVA TELEMETRY & VIDEO: LiveKit Cloud (WebRTC SFU)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 4. IN-MEMORY CACHE & RATE LIMITING: Redis
REDIS_URL=redis://localhost:6379

# 5. MESSAGES & DISCUSSION CHANNELS: Google Firebase Firestore
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional for local offline Firestore testing:
# FIRESTORE_EMULATOR_HOST=localhost:8080

# 6. AI INTELLIGENCE & OCR SYNTHESIS: Google Gemini API
AI_MODEL_PROVIDER=gemini-1.5-flash
GEMINI_API_KEY=
